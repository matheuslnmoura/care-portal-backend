JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=
JWT_REFRESH_EXPIRY=
REFRESH_TOKEN_HASH_SECRET=
NODE_ENV=
APPLICATION_ENVIRONMENT= # picks which .env.<name> file bootstrap-env.ts loads; defaults to "default"

# App
BASE_ROUTE= # defaults to /api
PORT= # defaults to 8090
PASSWORD_SALT_ROUNDS= # defaults to 10

# Postgres (required — the app has no fallback host, only a "localhost" dev convenience default)
POSTGRES_HOST=
POSTGRES_PORT= # defaults to 5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASS=
POSTGRES_POOL_MAX= # defaults to 10
POSTGRES_IDLE_TIMEOUT_MS= # defaults to 30000

# MongoDB (optional — connection is skipped entirely if MONGODB_URL is unset)
MONGODB_URL=
MONGODB_MIN_POOL_SIZE= # defaults to 10
MONGODB_CONNECT_TIMEOUT_MS= # defaults to 30000

# Redis (optional — connection is skipped entirely if REDIS_HOST is unset)
REDIS_HOST=
REDIS_PORT= # defaults to 6379
REDIS_TTL= # defaults to 86400 (seconds)
REDIS_MAX_RETRIES_PER_REQUEST= # defaults to 1

# Audit logging (each defaults to the value noted; see api/models/audit-model.ts)
LOG_AUDIT_INFO= # defaults to false
LOG_AUDIT_WARN= # defaults to false
LOG_AUDIT_ERROR= # defaults to true
LOG_AUDIT_SUCCESS= # defaults to true
LOG_AUDIT_FATAL= # defaults to true