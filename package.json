{
  "name": "care-portal-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "clear:dist": "rm -rf dist/*",
    "compile": "npm run clear:dist; tsc -p tsconfig.build.json",
    "start": "clear; npm run compile; node dist/server.js",
    "dev": "export NODE_ENV=default; clear; nodemon --watch api -e ts --exec \"tsx api/server.ts\" | tee server.log",
    "lint": "clear; ./node_modules/.bin/eslint \"api/**/*.ts\" ",
    "lint:fix": "clear; ./node_modules/.bin/eslint \"api/**/*.ts\" --fix",
    "test": "npm run test:integration && npm run test:unit:coverage",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate:up": "node scripts/db/run-migrations.js up",
    "migrate:status": "node scripts/db/run-migrations.js status"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@stylistic/eslint-plugin": "^2.12.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/ms": "^2.1.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "^9.17.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-transform-paths": "^3.5.3",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "http-status-codes": "^2.3.0",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.2",
    "ms": "^2.1.3",
    "nanoid": "^5.0.9",
    "pg": "^8.16.3",
    "redis": "^4.7.0"
  }
}
